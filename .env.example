# Copy to .env and adjust. Never commit .env.

# Instagram account used for collection (username only; the password is asked interactively).
IG_USERNAME=
# Optional: only if you really cannot type it interactively. Prefer leaving this empty.
# IG_PASSWORD=

# Where the session (auth cookies) is stored. Must stay outside Git (.secrets/ is ignored).
IG_SESSION_FILE=.secrets/ig_session.json
# Optional HTTP/SOCKS proxy, e.g. http://user:pass@host:port
IG_PROXY=

# SQLite database
OVERLAP_DB_PATH=data/overlap.sqlite3

# Collection defaults (all editable in the UI)
COLLECT_PAGE_SIZE=100
COLLECT_MAX_FOLLOWERS=2000
COLLECT_DELAY_MIN=8
COLLECT_DELAY_MAX=15
COLLECT_MAX_RETRIES=2
COLLECT_BACKOFF_SECONDS=300
